# ---------------------------------------------------------------------------
# Crunch Fitness — crunchfitness.in
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# MyGymDesk Website API ------------------------------------------------------
# SERVER-SIDE ONLY. MGD_API_KEY grants write access to the gym's CRM and
# booking system — it must never appear in a client component, in any
# NEXT_PUBLIC_* variable, or in browser JS. All MGD calls go through
# src/lib/mgd/, which is marked server-only.
MGD_API_BASE=https://db.mygymdesk.in/functions/v1
MGD_API_KEY=

# Client Supabase project ----------------------------------------------------
# The website's own Supabase project (content, enquiries, orders mirror,
# shipments, admin auth). Separate from MyGymDesk's Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shiprocket (Phase 5) -------------------------------------------------------
# SERVER-SIDE ONLY.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Site -----------------------------------------------------------------------
# Absolute origin, used for canonical URLs, sitemap.xml and OG tags.
NEXT_PUBLIC_SITE_URL=https://crunchfitness.in

# ---------------------------------------------------------------------------
# Crunch Fitness — crunchfitness.in
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Run `npm run check:env` after editing. It fails the build on the two
# mistakes that are expensive in production and invisible in review:
# a raw *.supabase.co URL, and a server secret behind a NEXT_PUBLIC_* name.
# ---------------------------------------------------------------------------

# MyGymDesk Website API ------------------------------------------------------
# SERVER-SIDE ONLY. MGD_API_KEY grants write access to the gym's CRM and
# booking system — it must never appear in a client component, in any
# NEXT_PUBLIC_* variable, or in browser JS. All MGD calls go through
# src/lib/mgd/, which is marked server-only.
#
# The key is generated ONCE by the gym owner at:
#   Settings → Growth & Apps → Integrations → Website Lead Capture
# It is shown once and stored only as a hash — it cannot be retrieved later,
# only regenerated (which invalidates the old one immediately, with no grace
# period). Copy it straight into .env.local and into Vercel; never paste it
# into a chat, a ticket, a log line or a commit.
#
# Format: mgd_live_ + 32 lowercase alphanumerics (41 chars total).
MGD_API_BASE=https://db.mygymdesk.in/functions/v1
MGD_API_KEY=

# Client Supabase project ----------------------------------------------------
# The website's own Supabase project (content, enquiries, orders mirror,
# shipments, admin auth). Separate from MyGymDesk's Supabase.
#
# ⚠ MUST be the Cloudflare-proxied custom domain, e.g. https://db.crunchfitness.in
#   NOT the raw https://<ref>.supabase.co host. Raw Supabase domains are
#   blocked by several Indian ISPs, and this URL is used by the visitor's
#   BROWSER (sign-in, admin panel, My Orders) — a raw URL silently breaks
#   those for real customers. `npm run check:env` enforces it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Local-dev escape hatch for the raw-URL check above. Never set this in
# Vercel: the check ignores it for production builds anyway.
# ALLOW_RAW_SUPABASE_URL=true

# Shiprocket (Phase 5) -------------------------------------------------------
# SERVER-SIDE ONLY.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Site -----------------------------------------------------------------------
# Absolute origin, used for canonical URLs, sitemap.xml and OG tags.
NEXT_PUBLIC_SITE_URL=https://crunchfitness.in
